APP_NAME="Spumoni Pop Up Shops"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://spumoni.test/

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spumoni
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# Which Filesystem to use, default is public / local
# FILESYSTEM_DRIVER='public'

# AWS S3 Keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Digital Ocean Spaces
DIGITALOCEAN_SPACES_KEY=[KEY]
DIGITALOCEAN_SPACES_SECRET=[SECRET]
DIGITALOCEAN_SPACES_ENDPOINT=https://[REGION].digitaloceanspaces.com
DIGITALOCEAN_SPACES_REGION=[REGION]
DIGITALOCEAN_SPACES_BUCKET=[YOURBUCKET]


# Set the Google Analytics Gtag ID to enable analytics tracking
GOOGLE_GTAG_ID=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# STRIPE KEYS
STRIPE_KEY=your-stripe-key
STRIPE_SECRET=your-stripe-secret

# OAuth Login -  Socialite Stuff
# Boolean to enable OAUTH
OAUTH_LOGIN_ENABLED=false

# THE PROVIDERS TO SHOW ON THE OAUTH MENU 
# only services defined in the config file and setup with socilate work
# This just lets you turn on / off a service that is already set and 
# defines what to show in the menu
# uppercase array "FACEBOOK,TWITTER,GOOGLE" 
OAUTH_PROVIDERS="" 

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="/login/google/callback"

# Twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URL="/login/twitter/callback"

# Facebook stuff
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL="/login/facebook/callback"

# DEBUG BAR
DEBUGBAR_ENABLED = FALSE

# SHOPIFY SDK
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Remove BG Key
REMOVEBG_API_KEY=

# Sentry Monitoring
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# KLAVIYO Marketing
KLAVIYO_PUBLIC_KEY=
KLAVIYO_PRIVATE_KEY=
KLAVIYO_REGISTRATION_LIST_ID=