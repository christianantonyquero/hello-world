# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://worldexplorer:worldexplorer_secret@localhost:5432/world_explorer?schema=public"

POSTGRES_USER=worldexplorer
POSTGRES_PASSWORD=worldexplorer_secret
POSTGRES_DB=world_explorer
POSTGRES_PORT=5432

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── JWT (Phase 2) ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string

# ── AWS (Phase 4) ─────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_RAW_BUCKET=world-explorer-raw-uploads
S3_PROCESSED_BUCKET=world-explorer-processed-videos
SQS_QUEUE_URL=
MEDIACONVERT_ENDPOINT=
MEDIACONVERT_ROLE_ARN=
CLOUDFRONT_BASE_URL=

# ── Cloudinary (Phase 6) ──────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
